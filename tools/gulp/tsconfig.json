{
  "compilerOptions": {
    "experimentalDecorators": true,
    // TS 6 defaults noImplicitAny to true; build scripts predate that, keep loose checking.
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "ignoreDeprecations": "6.0",
    "noUnusedParameters": true,
    "lib": [
      "es2017"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "strictNullChecks": true,
    "target": "es2018",
    "typeRoots": [
      "node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "baseUrl": "."
  },
  "files": [
    "gulpfile.ts"
  ]
}
